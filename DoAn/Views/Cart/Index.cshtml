@model List<CartRow>
@{ViewData["Title"]="Giỏ hàng";var total=Model.Sum(r=>r.Total);}
<section class="container section"><p class="eyebrow">FALCON / GIỎ HÀNG</p><h1 class="mb-4">Chiếc xe cho hành trình mới</h1><div class="row g-4"><div class="col-lg-8"><div class="table-responsive"><table class="table"><thead><tr><th>Xe</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th><th></th></tr></thead><tbody>@foreach(var r in Model){<tr><td><a href="/Catalog/Details/@r.Product.ProductId">@r.Product.ProductName</a><div class="muted small">Tồn kho: @r.Product.StockQuantity</div></td><td>@r.Product.Price.ToString("N0") ₫</td><td><form asp-action="Update" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@r.Product.ProductId"><input name="quantity" type="number" min="1" max="99" value="@r.Quantity" class="form-control" style="width:80px" aria-label="Số lượng @r.Product.ProductName"><button class="btn btn-sm fc-outline">Lưu</button></form></td><td>@r.Total.ToString("N0") ₫</td><td><form asp-action="Remove" method="post"><input type="hidden" name="id" value="@r.Product.ProductId"><button class="btn btn-sm btn-outline-danger">Xóa</button></form></td></tr>}</tbody></table></div>@if(Model.Count==0){<p class="filter-panel">Giỏ hàng đang trống. <a href="/Catalog" class="text-warning">Khám phá xe ↗</a></p>}<form asp-action="Clear" method="post" data-confirm="Làm trống giỏ hàng?"><button class="btn fc-outline">Làm trống giỏ hàng</button></form></div><div class="col-lg-4"><div class="filter-panel"><h2 class="h4">Tổng quan chi phí</h2><p>Tạm tính: <strong>@total.ToString("N0") ₫</strong></p><p class="price">Cọc dự kiến 10%: @((total*.1m).ToString("N0")) ₫</p><p class="muted small">Giá và tồn kho được kiểm tra lại khi đặt mua. Đơn chưa giữ xe; cửa hàng xác nhận sau.</p>@if(Model.Count>0){<a href="/Checkout" class="btn fc-btn w-100">Tiến hành đặt mua</a>}</div></div></div></section>