@model Product
@{ViewData["Title"]="Thêm vào giỏ hàng";}
<section class="container section"><div class="commerce-card commerce-form mx-auto"><h1 class="h2">@Model.ProductName</h1><p class="price">@Model.Price.ToString("N0") ₫</p><form asp-action="Add" method="post"><input type="hidden" name="id" value="@Model.ProductId"><input type="hidden" name="buy" value="@ViewBag.Buy.ToString()"><label for="quantity" class="form-label">Số lượng</label><input id="quantity" name="quantity" type="number" min="1" max="@Math.Min(99,Model.StockQuantity)" value="1" class="form-control"><button class="btn fc-btn mt-3" disabled="@(Model.StockQuantity==0)">@(ViewBag.Buy?"Tiếp tục đặt mua":"Thêm vào giỏ")</button></form><a href="/Catalog" class="text-warning d-block mt-3">Tiếp tục khám phá</a></div></section>