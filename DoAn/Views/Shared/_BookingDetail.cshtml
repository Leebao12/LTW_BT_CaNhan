@model TestDriveBooking
<div class="commerce-card"><p class="eyebrow">FALCON / LỊCH LÁI THỬ</p><h1 class="h3">@Model.BookingCode</h1><p class="text-warning">@StatusText.Of(Model.Status)</p><dl class="commerce-meta mt-4"><div><dt>Mẫu xe</dt><dd>@Model.Car.ProductName</dd></div><div><dt>Showroom</dt><dd>@Model.Showroom.ShowroomName<br>@Model.Showroom.Address</dd></div><div><dt>Ngày giờ (Việt Nam)</dt><dd>@Model.AppointmentDate.ToString("dd/MM/yyyy")<br>@Model.AppointmentTimeSlot</dd></div><div><dt>Khách hàng</dt><dd>@Model.FullName</dd></div><div><dt>Điện thoại</dt><dd>@Model.PhoneNumber</dd></div><div><dt>Email</dt><dd>@Model.Email</dd></div><div><dt>Giấy phép lái xe</dt><dd>@(Model.DriverLicenseNumber??"Chưa cung cấp")</dd></div></dl><p style="white-space:pre-line">@Model.CustomerNotes</p></div>