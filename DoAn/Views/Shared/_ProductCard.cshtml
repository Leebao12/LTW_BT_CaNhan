@model Product
<div class="col-md-6 col-xl-4"><article class="fc-card"><a asp-controller="Catalog" asp-action="Details" asp-route-id="@Model.ProductId"><img src="@(Model.PrimaryImageUrl ?? "/images/missing.svg")" alt="@Model.ProductName" loading="lazy"/></a><div class="p-4"><div class="d-flex justify-content-between"><span class="eyebrow">@Model.Category.CategoryName</span>@if(Model.StockQuantity==0){<span class="badge badge-red">Hết hàng</span>}else if(Model.IsFeatured){<span class="badge bg-warning text-dark">Nổi bật</span>}</div><h3 class="h5 mt-2">@Model.ProductName</h3><p class="muted small">@Model.Displacement cc · @Model.StockQuantity xe trong kho</p><div class="border-top border-secondary pt-3 d-flex justify-content-between align-items-center"><span class="price">@Model.Price.ToString("N0",System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) ₫</span><a asp-controller="Catalog" asp-action="Details" asp-route-id="@Model.ProductId" class="btn fc-outline px-3" aria-label="Xem @Model.ProductName">↗</a></div></div></article></div>