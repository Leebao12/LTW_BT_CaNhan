<nav class="d-flex align-items-center gap-3 mt-4" aria-label="Phân trang">@if(ViewBag.Page>1){<a asp-action="Index" asp-route-page="@(ViewBag.Page-1)" asp-route-q="@ViewBag.Q" asp-route-status="@ViewBag.Status" class="btn fc-outline">← Trước</a>}<span class="muted">Trang @ViewBag.Page / @ViewBag.Pages</span>@if(ViewBag.Page<ViewBag.Pages){<a asp-action="Index" asp-route-page="@(ViewBag.Page+1)" asp-route-q="@ViewBag.Q" asp-route-status="@ViewBag.Status" class="btn fc-outline">Sau →</a>}</nav>