@model SalesOrder
<div class="commerce-card"><h1 class="h3">Đơn hàng @Model.OrderCode</h1><p class="muted">Đặt ngày @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm") · @StatusText.Of(Model.OrderStatus)</p><dl class="commerce-meta"><div><dt>Khách hàng</dt><dd>@Model.CustomerName</dd></div><div><dt>Điện thoại</dt><dd>@Model.CustomerPhone</dd></div><div><dt>Email</dt><dd>@Model.CustomerEmail</dd></div><div><dt>Địa chỉ</dt><dd>@(Model.CustomerAddress??"Chưa cung cấp")</dd></div><div><dt>Thanh toán</dt><dd>@StatusText.Of(Model.PaymentStatus)</dd></div><div><dt>Phương thức</dt><dd>@(Model.PaymentMethod=="Showroom_Deposit"?"Đặt cọc tại showroom":"Chuyển khoản theo hướng dẫn")</dd></div></dl><div class="table-responsive"><table class="table"><thead><tr><th>Xe</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead><tbody>@foreach(var d in Model.Details){<tr><td>@d.CarName @d.ExteriorColor</td><td>@d.Quantity</td><td>@d.UnitPrice.ToString("N0") ₫</td><td>@((d.Quantity*d.UnitPrice).ToString("N0")) ₫</td></tr>}</tbody></table></div><div class="order-line"><span>Tạm tính</span><strong>@Model.SubTotal.ToString("N0") ₫</strong></div><div class="order-line"><span>Ưu đãi @Model.Coupon?.Code</span><strong>−@Model.DiscountAmount.ToString("N0") ₫</strong></div><div class="order-line text-warning"><span>Tổng tiền</span><strong>@Model.TotalAmount.ToString("N0") ₫</strong></div><p class="mt-3">Cọc dự kiến: <strong>@Model.DepositAmount.ToString("N0") ₫</strong></p><p class="muted small">Số cọc dự kiến không phải xác nhận đã thu tiền. Xem trạng thái thanh toán và liên hệ cửa hàng để được hướng dẫn.</p><p style="white-space:pre-line">@Model.Note</p></div>