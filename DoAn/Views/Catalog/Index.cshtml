@model CatalogVm
@{ViewData["Title"]="Khám phá xe";}
<section class="section container"><p class="eyebrow">FALCON / COLLECTION</p><h1 class="display-5 fw-bold">Tìm chiếc xe của bạn.</h1><p class="muted mb-5">Lọc theo hãng, mức giá và phân khối.</p><div class="row g-4"><aside class="col-lg-3"><form method="get" class="filter-panel"><h2 class="h5">Bộ lọc xe</h2><label asp-for="Search" class="form-label mt-3">Tìm kiếm</label><input asp-for="Search" maxlength="100" class="form-control" placeholder="Tên xe, hãng xe…"/><label asp-for="CategoryId" class="form-label mt-3">Hãng xe</label><select asp-for="CategoryId" class="form-select"><option value="">Tất cả hãng</option>@foreach(var c in Model.Categories){<option value="@c.CategoryId">@c.CategoryName</option>}</select>
<label asp-for="Price" class="form-label mt-3">Mức giá</label><select asp-for="Price" class="form-select"><option value="">Tất cả mức giá</option><option value="under30">Dưới 30 triệu</option><option value="30to50">30 đến dưới 50 triệu</option><option value="50to100">50 đến dưới 100 triệu</option><option value="over100">Từ 100 triệu</option></select>
<label asp-for="Cc" class="form-label mt-3">Phân khối</label><select asp-for="Cc" class="form-select"><option value="">Tất cả phân khối</option><option value="under125">Dưới 125 cc</option><option value="125to150">125 đến 150 cc</option><option value="over150">Trên 150 cc</option></select>
<label asp-for="Sort" class="form-label mt-3">Sắp xếp</label><select asp-for="Sort" class="form-select"><option value="new">Mới nhất</option><option value="asc">Giá tăng dần</option><option value="desc">Giá giảm dần</option></select><button class="btn fc-btn w-100 mt-4">Áp dụng</button><a asp-action="Index" class="btn fc-outline w-100 mt-2">Xóa bộ lọc</a></form></aside>
<div class="col-lg-9"><p class="muted">@Model.Total mẫu xe · Trang @Model.Page / @Model.Pages</p><div class="row g-4">@foreach(var p in Model.Products){<partial name="_ProductCard" model="p"/>}@if(Model.Total==0){<div class="col"><div class="filter-panel"><h2 class="h4">Không tìm thấy xe</h2><p>Thử từ khóa khác hoặc xóa bộ lọc.</p></div></div>}</div><nav class="mt-4" aria-label="Phân trang xe"><ul class="pagination flex-wrap">
@for(int i=Math.Max(1,Model.Page-2);i<=Math.Min(Model.Pages,Model.Page+2);i++){<li class="page-item @(i==Model.Page?"active":"")"><a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-price="@Model.Price" asp-route-cc="@Model.Cc" asp-route-sort="@Model.Sort">@i</a></li>}
</ul></nav></div></div></section>