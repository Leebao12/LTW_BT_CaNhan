@model Product
@{ViewData["Title"]=Model.ProductName;}
<section class="section container"><nav class="muted mb-4"><a href="/">Trang chủ</a> / <a href="/Catalog">Bộ sưu tập</a> / @Model.ProductName</nav><div class="row g-5"><div class="col-lg-7"><img id="main-photo" class="gallery" src="@(Model.PrimaryImageUrl ?? "/images/missing.svg")" alt="@Model.ProductName"/><div class="d-flex flex-wrap gap-2 mt-3">@foreach(var image in Model.Images.OrderByDescending(i=>i.IsPrimary)){<button type="button" class="btn p-0" data-gallery-src="@image.ImageUrl" aria-label="Xem ảnh @Model.ProductName"><img class="thumb" src="@image.ImageUrl" alt="Góc chụp @Model.ProductName"/></button>}</div></div><div class="col-lg-5"><p class="eyebrow">@Model.Category.CategoryName / MOTORCYCLES</p><h1 class="display-5 fw-bold">@Model.ProductName</h1><p class="price fs-2 my-4">@Model.Price.ToString("N0",System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) ₫</p><p class="@(Model.StockQuantity>0?"text-warning":"text-danger")">@(Model.StockQuantity>0?$"Còn {Model.StockQuantity} xe":"Tạm hết hàng")</p><p>Màu sắc: @(Model.ColorOptions ?? "Chưa cập nhật")</p>@if(User.IsInRole("Customer")){
<form asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="id" value="@Model.ProductId"><div class="d-flex gap-2 mb-3"><input type="number" name="quantity" min="1" max="@Math.Min(99,Model.StockQuantity)" value="1" class="form-control" aria-label="Số lượng"><button name="buy" value="false" class="btn fc-outline" disabled="@(Model.StockQuantity==0)">Thêm vào giỏ</button></div><button name="buy" value="true" class="btn fc-btn w-100 mb-3" disabled="@(Model.StockQuantity==0)">Đặt mua ngay</button></form>
<a href="/Booking/Create?carId=@Model.ProductId" class="btn fc-outline w-100">Đăng ký lái thử</a>
}else if(User.Identity?.IsAuthenticated!=true){
@if(Model.StockQuantity>0){<a href="@Url.Action("Login","Account",new{returnUrl=$"/Cart/Add?id={Model.ProductId}"})" data-login-required class="btn fc-outline w-100 mb-3">Thêm vào giỏ hàng</a><a href="@Url.Action("Login","Account",new{returnUrl=$"/Cart/Add?id={Model.ProductId}&buy=true"})" data-login-required class="btn fc-btn w-100 mb-3">Đặt mua ngay</a>}
<a href="@Url.Action("Login","Account",new{returnUrl=$"/Booking/Create?carId={Model.ProductId}"})" data-login-required class="btn fc-outline w-100">Đăng ký lái thử</a>
}else{<a href="/Admin/Products/Details/@Model.ProductId" class="btn fc-outline">Quản lý sản phẩm</a>}
</div></div>
<div class="mt-5"><ul class="nav nav-tabs"><li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#spec">Thông số kỹ thuật</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#intro">Giới thiệu</button></li></ul><div class="tab-content p-4 fc-card"><div class="tab-pane fade show active" id="spec"><table class="table mb-0"><tbody><tr><th>Hãng xe</th><td>@Model.Category.CategoryName</td></tr><tr><th>Dung tích xi-lanh</th><td>@Model.Displacement cc</td></tr><tr><th>Loại động cơ</th><td>@(Model.EngineType??"Chưa cập nhật")</td></tr><tr><th>Dung tích bình xăng</th><td>@(Model.FuelCapacity?.ToString("0.##")??"Chưa cập nhật") lít</td></tr><tr><th>Màu sắc</th><td>@Model.ColorOptions</td></tr></tbody></table></div><div class="tab-pane fade" id="intro" style="white-space:pre-line">@(Model.Description??"Chưa cập nhật mô tả.")</div></div></div></section>