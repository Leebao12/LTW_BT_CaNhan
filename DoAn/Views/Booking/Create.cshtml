@model BookingVm
@{ViewData["Title"]="Đăng ký lái thử";}
<section class="container section"><div class="commerce-card commerce-form mx-auto"><p class="eyebrow">FALCON / TRẢI NGHIỆM</p><h1 class="h2">Đặt lịch lái thử</h1><p class="muted">Chọn mẫu xe, showroom và khung giờ. Cửa hàng sẽ liên hệ xác nhận lịch hẹn.</p><form asp-action="Create" method="post"><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control"><span asp-validation-for="FullName" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" class="form-control"><span asp-validation-for="PhoneNumber" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control"><span asp-validation-for="Email" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="DriverLicenseNumber" class="form-label"></label><input asp-for="DriverLicenseNumber" class="form-control"><span asp-validation-for="DriverLicenseNumber" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="CarId" class="form-label"></label><select asp-for="CarId" asp-items="ViewBag.Cars" class="form-select"><option value="">Chọn mẫu xe</option></select></div><div class="col-md-6"><label asp-for="ShowroomId" class="form-label"></label><select asp-for="ShowroomId" asp-items="ViewBag.Showrooms" class="form-select"><option value="">Chọn showroom</option></select></div><div class="col-md-6"><label asp-for="AppointmentDate" class="form-label"></label><input asp-for="AppointmentDate" type="date" class="form-control"><span asp-validation-for="AppointmentDate" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="AppointmentTimeSlot" class="form-label"></label><select asp-for="AppointmentTimeSlot" class="form-select"><option value="">Chọn khung giờ</option>@foreach(var slot in BookingPolicy.Slots){<option>@slot</option>}</select></div><div class="col-12"><label asp-for="CustomerNotes" class="form-label"></label><textarea asp-for="CustomerNotes" class="form-control" rows="3"></textarea></div></div><p class="muted small mt-3">Đặt từ ngày mai đến 90 ngày tới (giờ Việt Nam). Mỗi xe tại một showroom nhận một lịch trong cùng khoảng giờ. Có thể hủy trước giờ hẹn hơn 2 tiếng.</p><button class="btn fc-btn mt-2">Gửi đăng ký lái thử</button><a asp-action="Index" class="btn fc-outline mt-2">Lịch hẹn của tôi</a></form></div></section>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}