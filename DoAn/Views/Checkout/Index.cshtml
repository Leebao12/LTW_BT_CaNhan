@model CheckoutVm
@{ViewData["Title"]="Đặt mua";}
<section class="container section"><p class="eyebrow">FALCON / ĐẶT MUA</p><h1 class="mb-4">Hoàn thiện thông tin đặt mua</h1><form asp-action="Index" method="post"><input asp-for="Token" type="hidden"><div asp-validation-summary="All" class="alert alert-danger"></div><div class="row g-4"><div class="col-lg-7"><div class="commerce-card"><h2 class="h4 mb-4">Thông tin liên hệ</h2><div class="row g-3"><div class="col-md-6"><label asp-for="CustomerName" class="form-label"></label><input asp-for="CustomerName" class="form-control"><span asp-validation-for="CustomerName" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="CustomerPhone" class="form-label"></label><input asp-for="CustomerPhone" class="form-control"><span asp-validation-for="CustomerPhone" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="CustomerEmail" class="form-label"></label><input asp-for="CustomerEmail" class="form-control"><span asp-validation-for="CustomerEmail" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="CustomerAddress" class="form-label"></label><input asp-for="CustomerAddress" class="form-control"><span asp-validation-for="CustomerAddress" class="text-danger small"></span></div><div class="col-12"><label asp-for="Note" class="form-label"></label><textarea asp-for="Note" class="form-control" rows="3"></textarea></div><div class="col-12"><label asp-for="PaymentMethod" class="form-label"></label><select asp-for="PaymentMethod" class="form-select"><option value="Showroom_Deposit">Đặt cọc tại showroom</option><option value="BankTransfer_QR">Chuyển khoản theo hướng dẫn của cửa hàng</option></select></div></div><p class="muted small mt-3">Đây là yêu cầu đặt mua. Cửa hàng sẽ liên hệ để xác nhận xe và hướng dẫn thanh toán. Website chưa thu tiền trực tuyến.</p></div></div><div class="col-lg-5"><div class="filter-panel"><h2 class="h4">Đơn hàng của bạn</h2>@foreach(var r in Model.Rows){<div class="order-line"><span>@r.Product.ProductName × @r.Quantity</span><strong>@r.Total.ToString("N0") ₫</strong></div>}<div class="order-line"><span>Tạm tính</span><strong>@Model.SubTotal.ToString("N0") ₫</strong></div><div class="order-line text-success"><span>Giảm giá</span><strong>−@Model.Discount.ToString("N0") ₫</strong></div><div class="order-line"><span>Tổng thanh toán</span><strong class="text-warning">@Model.Total.ToString("N0") ₫</strong></div><p class="price mt-3">Cọc dự kiến 10%: @Model.Deposit.ToString("N0") ₫</p><label asp-for="CouponCode" class="form-label"></label><div class="input-group"><input asp-for="CouponCode" class="form-control text-uppercase" placeholder="Nhập mã ưu đãi"><button name="intent" value="preview" class="btn fc-outline" formnovalidate>Áp dụng</button></div><p class="small muted mt-2">Xóa mã rồi bấm Áp dụng để gỡ ưu đãi. Mã được kiểm tra lại lúc đặt mua.</p><button name="intent" value="place" class="btn fc-btn w-100 mt-3">Xác nhận đặt mua</button><a href="/Cart" class="d-block text-warning mt-3">← Chỉnh sửa giỏ hàng</a></div></div></div></form></section>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}