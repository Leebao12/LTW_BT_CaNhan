@model LoginVm
@{ViewData["Title"]="Đăng nhập";}
<section class="container section"><div class="filter-panel mx-auto" style="max-width:480px"><p class="eyebrow">FALCON / TÀI KHOẢN</p><h1 class="h2">Chào mừng trở lại</h1><p class="muted">Đăng nhập để truy cập phân hệ của bạn.</p>
<form asp-action="Login" method="post"><input asp-for="ReturnUrl" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<label asp-for="Username" class="form-label mt-3"></label><input asp-for="Username" autocomplete="username" class="form-control"/><span asp-validation-for="Username" class="text-danger"></span>
<label asp-for="Password" class="form-label mt-3"></label><input asp-for="Password" autocomplete="current-password" class="form-control"/><span asp-validation-for="Password" class="text-danger"></span>
<button class="btn fc-btn w-100 mt-4">Đăng nhập</button></form><p class="mt-4 mb-0">Chưa có tài khoản? <a class="text-warning" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Hãy đăng ký</a></p></div></section>
@section Scripts {<partial name="_ValidationScriptsPartial"/>}
