@model CustomerProfile
@{ViewData["Title"]="Tài khoản của tôi";}
<section class="container section"><div class="commerce-card commerce-form mx-auto"><p class="eyebrow">FALCON / TÀI KHOẢN</p><h1>@Model.FullName</h1><dl class="commerce-meta mt-4"><div><dt>Tên đăng nhập</dt><dd>@User.Identity?.Name</dd></div><div><dt>Email</dt><dd>@ViewBag.Email</dd></div><div><dt>Điện thoại</dt><dd>@(Model.Phone??"Chưa cung cấp")</dd></div><div><dt>Địa chỉ</dt><dd>@(Model.Address??"Chưa cung cấp")</dd></div></dl>@if(User.IsInRole("Customer")){<a href="/Orders" class="btn fc-btn">Đơn hàng của tôi</a><a href="/Booking" class="btn fc-outline">Lịch lái thử</a>}else{<a href="/Admin" class="btn fc-btn">Trang quản trị</a>}</div></section>