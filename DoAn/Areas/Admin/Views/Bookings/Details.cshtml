@model TestDriveBooking
@{ViewData["Title"]="Xử lý lịch hẹn";}
<partial name="_BookingDetail"/><p class="mt-3" style="white-space:pre-line">Ghi chú nội bộ: @Model.StaffNotes</p>
@if(Model.Status is "Pending" or "Confirmed"){<form asp-action="Update" asp-route-id="@Model.BookingId" method="post" class="commerce-card mt-4"><input type="hidden" name="expected" value="@Model.Status"><h2 class="h4">Cập nhật lịch hẹn</h2><label for="status" class="form-label">Trạng thái mới</label><select name="status" id="status" class="form-select mb-3">@if(Model.Status=="Pending"){<option value="Confirmed">Xác nhận lịch</option>}else{<option value="Completed">Hoàn tất</option><option value="NoShow">Khách vắng mặt</option>}<option value="Cancelled">Hủy lịch</option></select><label for="notes" class="form-label">Ghi chú nội bộ</label><textarea name="notes" id="notes" maxlength="2000" class="form-control" rows="3">@Model.StaffNotes</textarea><button class="btn fc-btn mt-3">Lưu cập nhật</button></form>}<a asp-action="Index" class="btn fc-outline mt-3">← Danh sách lịch hẹn</a>