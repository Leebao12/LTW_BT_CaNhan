@model List<TestDriveBooking>
@{ViewData["Title"]="Lịch lái thử";}
<section class="container section"><p class="eyebrow">FALCON / LỊCH HẸN</p><h1 class="h2 mb-4">Lịch lái thử</h1><form method="get" class="row g-2 mb-4"><div class="col-md-6"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Mã lịch, tên hoặc điện thoại" aria-label="Tìm lịch hẹn"></div><div class="col-md-4"><select name="status" class="form-select" aria-label="Trạng thái"><option value="">Tất cả trạng thái</option>@foreach(var s in new[]{"Pending","Confirmed","Completed","Cancelled","NoShow"}){<option value="@s" selected="@(s==(string?)ViewBag.Status)">@StatusText.Of(s)</option>}</select></div><div class="col-md-2"><button class="btn fc-outline">Tìm</button></div></form><div class="table-responsive"><table class="table"><thead><tr><th>Mã lịch / Khách hàng</th><th>Xe / Showroom</th><th>Ngày giờ</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var b in Model){<tr><td>@b.BookingCode<div class="small muted">@b.FullName</div></td><td>@b.Car.ProductName<div class="small muted">@b.Showroom.ShowroomName</div></td><td>@b.AppointmentDate.ToString("dd/MM/yyyy")<div>@b.AppointmentTimeSlot</div></td><td>@StatusText.Of(b.Status)</td><td><a asp-action="Details" asp-route-id="@b.BookingId" class="btn btn-sm fc-outline">Chi tiết</a></td></tr>}</tbody></table></div>@if(Model.Count==0){<p class="filter-panel">Chưa có lịch hẹn phù hợp.</p>}<partial name="_CommercePager"/></section>