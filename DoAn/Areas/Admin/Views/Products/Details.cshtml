@model Falcon.Web.Models.Admin.Product
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Chi tiết sản phẩm</h2>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
        <a asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-gold">Chỉnh sửa</a>
    </div>
</div>
<div class="row g-4">
    <div class="col-lg-5">
        <div class="card"><div class="card-body text-center">
            @if (!string.IsNullOrWhiteSpace(Model.PrimaryImageUrl))
            {
                <img src="@Model.PrimaryImageUrl" alt="@Model.ProductName"
                     style="width:100%;max-height:320px;object-fit:contain;background:white;border-radius:8px" />
            }
            else { <div class="text-muted p-5">Chưa có ảnh sản phẩm</div> }
            <h4 class="mt-3">@Model.ProductName</h4>
            <h3 class="text-warning">@Model.Price.ToString("N0") VNĐ</h3>
        </div></div>
    </div>
    <div class="col-lg-7">
        <div class="card"><div class="card-body">
            <h5 class="text-warning mb-3">Thông tin xe máy</h5>
            <table class="table align-middle"><tbody>
                <tr><th>Mã sản phẩm</th><td>#@Model.ProductId</td></tr>
                <tr><th>Tên xe</th><td>@Model.ProductName</td></tr>
                <tr><th>Hãng xe</th><td>@Model.Category.CategoryName</td></tr>
                <tr><th>Slug</th><td>@Model.Slug</td></tr>
                <tr><th>Giá bán</th><td>@Model.Price.ToString("N0") VNĐ</td></tr>
                <tr><th>Phân khối</th><td>@Model.Displacement cc</td></tr>
                <tr><th>Loại động cơ</th><td>@(Model.EngineType ?? "Chưa cập nhật")</td></tr>
                <tr><th>Dung tích bình xăng</th><td>@(Model.FuelCapacity?.ToString("N2") ?? "Chưa cập nhật") lít</td></tr>
                <tr><th>Màu sắc</th><td>@(Model.ColorOptions ?? "Chưa cập nhật")</td></tr>
                <tr><th>Tồn kho</th><td>@Model.StockQuantity chiếc</td></tr>
                <tr><th>Trạng thái</th><td>@(Model.Status == "Active" ? "Đang bán" : "Ngừng bán")</td></tr>
                <tr><th>Nổi bật</th><td>@(Model.IsFeatured ? "Có" : "Không")</td></tr>
                <tr><th>Ngày tạo</th><td>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td></tr>
            </tbody></table>
            <h6 class="text-warning mt-3">Mô tả</h6>
            <div style="white-space:pre-line">@(Model.Description ?? "Chưa có mô tả")</div>
        </div></div>
    </div>
</div>
