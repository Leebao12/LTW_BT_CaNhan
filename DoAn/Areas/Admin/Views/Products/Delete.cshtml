@model Falcon.Web.Models.Admin.Product

@{
    ViewData["Title"] = "Xóa sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

    bool hasDependencies =
        (bool)(ViewBag.HasDependencies ?? false);
}

<div class="mb-4">
    <a asp-action="Index"
       class="text-decoration-none">
        <i class="bi bi-arrow-left"></i>
        Quay lại danh sách
    </a>
</div>

<h2 class="fw-bold mb-4">
    <i class="bi bi-exclamation-triangle text-danger"></i>
    Xác nhận xóa sản phẩm
</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="card">
    <div class="card-body p-4">

        @if (hasDependencies)
        {
            <div class="alert alert-warning">
                <strong>Không thể xóa sản phẩm này.</strong>
                <p class="mb-0 mt-2">
                    Sản phẩm đang được sử dụng trong đơn hàng,
                    lịch lái thử hoặc phiếu nhập kho.
                    Bạn có thể chuyển trạng thái sang
                    "Ngừng kinh doanh" thay vì xóa.
                </p>
            </div>
        }
        else
        {
            <div class="alert alert-danger">
                Bạn đang chuẩn bị xóa sản phẩm khỏi hệ thống.
                Thao tác này không thể hoàn tác.
                Các bản ghi ảnh liên quan trong
                ProductImages cũng sẽ bị xóa.
            </div>
        }

        <div class="d-flex flex-wrap align-items-center gap-4
                    p-3 rounded mb-4"
             style="background:#292930;">

            @if (!string.IsNullOrEmpty(Model.PrimaryImageUrl))
            {
                <img src="@Model.PrimaryImageUrl"
                     alt="@Model.ProductName"
                     style="width:160px;height:120px;
                            object-fit:contain;
                            background:white;border-radius:8px;" />
            }

            <div>
                <h4 class="fw-bold">@Model.ProductName</h4>

                <p class="text-muted mb-2">
                    @Model.Category.CategoryName
                </p>

                <div>Mã sản phẩm: #@Model.ProductId</div>

                <div class="text-warning fw-bold">
                    @Model.Price.ToString("N0") VNĐ
                </div>

                <div class="text-muted">
                    Tồn kho: @Model.StockQuantity xe
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Quay lại
            </a>

            @if (hasDependencies)
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.ProductId"
                   class="btn btn-gold">
                    Chỉnh sửa trạng thái
                </a>
            }
            else
            {
                <form asp-area="Admin"
                      asp-controller="Products"
                      asp-action="Delete"
                      asp-route-id="@Model.ProductId"
                      method="post"
                      onsubmit="return confirm('Bạn chắc chắn muốn xóa sản phẩm này?');">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-danger">
                        Xóa
                        Xác nhận xóa
                    </button>
                </form>
            }
        </div>
    </div>
</div>
