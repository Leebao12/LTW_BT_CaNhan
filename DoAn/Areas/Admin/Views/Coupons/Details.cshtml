@model Coupon
@{ViewData["Title"]="Chi tiết mã giảm giá";var orders=(List<SalesOrder>)ViewBag.Orders;var state=CouponRules.State(Model,BusinessClock.Now);}
<div data-modal-content class="commerce-card"><h1><span class="coupon-code-badge">@Model.Code</span></h1><p>@Model.Description</p><span class="badge badge-@state">@CouponRules.Label(state)</span><dl class="commerce-meta mt-4"><div><dt>Mức giảm</dt><dd>@Model.DiscountValue.ToString("N0") @(Model.DiscountType=="Percentage"?"%":"₫")</dd></div><div><dt>Đơn tối thiểu</dt><dd>@Model.MinOrderAmount.ToString("N0") ₫</dd></div><div><dt>Giảm tối đa</dt><dd>@(Model.MaxDiscountAmount?.ToString("N0")??"Không giới hạn")</dd></div><div><dt>Lượt sử dụng</dt><dd>@Model.UsedCount / @Model.UsageLimit</dd></div><div><dt>Hiệu lực</dt><dd>@Model.StartDate.ToString("dd/MM/yyyy HH:mm") → @Model.EndDate.ToString("dd/MM/yyyy HH:mm")</dd></div><div><dt>Ngày tạo</dt><dd>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd></div></dl><h2 class="h5 mt-4">Lịch sử đơn hàng (@orders.Count)</h2><div class="table-responsive"><table class="table"><thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Giảm giá</th><th>Tổng đơn</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var o in orders){<tr><td><a asp-controller="Orders" asp-action="Details" asp-route-id="@o.OrderId" class="text-warning">@o.OrderCode</a></td><td>@o.CustomerName</td><td>@o.DiscountAmount.ToString("N0") ₫</td><td>@o.TotalAmount.ToString("N0") ₫</td><td>@StatusText.Of(o.OrderStatus)</td></tr>}</tbody></table></div>@if(orders.Count==0){<p class="muted">Chưa có đơn áp dụng mã này.</p>}<a asp-action="Index" class="btn fc-outline">Quay lại</a></div>