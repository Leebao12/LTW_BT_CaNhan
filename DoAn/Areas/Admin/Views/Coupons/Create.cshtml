@model CouponCreateVm
@{ViewData["Title"]="Tạo mã giảm giá";}
<div data-modal-content class="commerce-card commerce-form"><h1 class="h2">Tạo mã giảm giá</h1><p class="muted">Mã được chuẩn hóa thành chữ in hoa. Số lượt dùng bắt đầu từ 0.</p><form asp-action="Create" method="post"><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3 mb-3"><div class="col-md-6"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control"><span asp-validation-for="Code" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="DiscountType" class="form-label"></label><select asp-for="DiscountType" class="form-select"><option value="Percentage">Phần trăm (%)</option><option value="FixedAmount">Số tiền cố định (₫)</option></select></div><div class="col-md-6"><label asp-for="DiscountValue" class="form-label"></label><input asp-for="DiscountValue" class="form-control"><span asp-validation-for="DiscountValue" class="text-danger small"></span></div></div><partial name="_Form" model="Model"/><div class="d-flex gap-2 mt-4"><button class="btn fc-btn">Tạo mã</button><a asp-action="Index" class="btn fc-outline">Quay lại</a></div></form></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}