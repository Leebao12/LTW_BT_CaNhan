@model CouponListVm
@{ViewData["Title"]="Mã giảm giá";}
<div class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><p class="eyebrow">FALCON / ƯU ĐÃI</p><h1 class="h2">Quản lý mã giảm giá</h1><p class="muted">Thiết lập ưu đãi và theo dõi lượt sử dụng.</p></div><div><a asp-action="Create" data-modal-link class="btn fc-btn">+ Tạo mã mới</a></div></div>
<div class="row g-3 mb-4">@foreach(var s in new[]{("Tổng số mã",(long)Model.All),("Đang hoạt động",(long)Model.Active),("Hết hạn",(long)Model.Expired),("Lượt sử dụng",Model.Used)}){<div class="col-6 col-lg-3"><div class="filter-panel text-center"><p class="muted mb-1">@s.Item1</p><div class="stats-num">@s.Item2</div></div></div>}</div>
<form method="get" class="filter-panel row g-3 mb-4"><div class="col-lg-4"><label for="q" class="form-label">Tìm mã hoặc mô tả</label><input id="q" name="q" value="@Model.Q" class="form-control"></div><div class="col-lg-3"><label for="type" class="form-label">Loại giảm</label><select id="type" asp-for="Type" name="type" class="form-select"><option value="">Tất cả</option><option value="Percentage">Phần trăm</option><option value="FixedAmount">Số tiền cố định</option></select></div><div class="col-lg-3"><label for="status" class="form-label">Trạng thái</label><select id="status" asp-for="Status" name="status" class="form-select"><option value="">Tất cả</option>@foreach(var state in new[]{"active","scheduled","inactive","expired","depleted"}){<option value="@state">@CouponRules.Label(state)</option>}</select></div><div class="col-lg-2 align-self-end"><button class="btn fc-outline">Lọc</button></div></form>
<div class="table-responsive"><table class="table coupon-table"><thead><tr><th>Mã giảm giá</th><th>Mức giảm</th><th>Điều kiện</th><th>Thời hạn</th><th>Lượt dùng</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var c in Model.Items){var state=CouponRules.State(c,BusinessClock.Now);var percent=(int)Math.Min(100,100m*c.UsedCount/c.UsageLimit);<tr><td><span class="coupon-code-badge">@c.Code</span><div class="small muted mt-2">@c.Description</div></td><td class="text-warning">@c.DiscountValue.ToString("N0") @(c.DiscountType=="Percentage"?"%":"₫")@if(c.MaxDiscountAmount.HasValue){<div class="small muted">Tối đa @c.MaxDiscountAmount.Value.ToString("N0") ₫</div>}</td><td>Từ @c.MinOrderAmount.ToString("N0") ₫</td><td class="small">@c.StartDate.ToString("dd/MM/yyyy HH:mm")<br>→ @c.EndDate.ToString("dd/MM/yyyy HH:mm")</td><td>@c.UsedCount / @c.UsageLimit<div class="progress mt-2" style="height:5px"><div class="progress-bar bg-warning" style="width:@(percent)%" role="progressbar" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"></div></div></td><td><span class="badge badge-@state">@CouponRules.Label(state)</span></td><td><div class="d-flex flex-wrap gap-1"><a asp-action="Details" asp-route-id="@c.CouponId" data-modal-link class="btn btn-sm btn-outline-info">Chi tiết</a><a asp-action="Edit" asp-route-id="@c.CouponId" data-modal-link class="btn btn-sm btn-outline-warning">Sửa</a><form asp-action="Toggle" asp-route-id="@c.CouponId" method="post"><input type="hidden" name="version" value="@CouponRules.Version(c)"><input type="hidden" name="active" value="@((!c.IsActive).ToString())"><button class="btn btn-sm btn-outline-secondary">@(c.IsActive?"Tắt":"Bật")</button></form><a asp-action="Delete" asp-route-id="@c.CouponId" data-modal-link class="btn btn-sm btn-outline-danger">Xóa</a></div></td></tr>}
@if(Model.Items.Count==0){<tr><td colspan="7" class="text-center py-5">Không tìm thấy mã giảm giá phù hợp.</td></tr>}</tbody></table></div><p class="muted">@Model.Total kết quả · Trang @Model.Page / @Model.Pages</p><nav class="d-flex gap-2">@if(Model.Page>1){<a class="btn fc-outline" asp-route-q="@Model.Q" asp-route-type="@Model.Type" asp-route-status="@Model.Status" asp-route-page="@(Model.Page-1)">← Trước</a>}@if(Model.Page<Model.Pages){<a class="btn fc-outline" asp-route-q="@Model.Q" asp-route-type="@Model.Type" asp-route-status="@Model.Status" asp-route-page="@(Model.Page+1)">Sau →</a>}</nav>

@section Scripts{<partial name="_ValidationScriptsPartial"/>}
