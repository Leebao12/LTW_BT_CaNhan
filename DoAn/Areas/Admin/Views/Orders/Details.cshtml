@model SalesOrder
@{ViewData["Title"]="Chi tiết đơn hàng";}
<partial name="_OrderDetail"/>
@if(Model.OrderStatus is not ("Completed" or "Cancelled")){<form asp-action="Update" asp-route-id="@Model.OrderId" method="post" class="commerce-card mt-4" data-confirm="Xác nhận cập nhật? Chỉ ghi nhận thanh toán khi đã kiểm tra tiền thực nhận."><h2 class="h4">Xử lý đơn hàng</h2><input type="hidden" name="expected" value="@Model.OrderStatus"><input type="hidden" name="expectedPayment" value="@Model.PaymentStatus"><div class="row g-3"><div class="col-md-5"><label for="status" class="form-label">Trạng thái đơn</label><select id="status" name="status" class="form-select">@foreach(var s in new[]{"Processing","Confirmed","Delivering","Completed","Cancelled"}){<option value="@s" selected="@(s==Model.OrderStatus)">@StatusText.Of(s)</option>}</select></div><div class="col-md-5"><label for="payment" class="form-label">Thanh toán thực tế</label><select id="payment" name="payment" class="form-select">@foreach(var s in new[]{"Pending","Deposited","Paid","Failed"}){<option value="@s" selected="@(s==Model.PaymentStatus)">@StatusText.Of(s)</option>}</select></div><div class="col-md-2 align-self-end"><button class="btn fc-btn">Cập nhật</button></div></div><p class="small muted mt-3">Luồng: Chờ xử lý → Đã xác nhận → Đang giao → Hoàn tất. Chỉ hoàn tất khi đã thanh toán đủ; tồn kho được trừ một lần lúc hoàn tất. Không hủy tại đây nếu đã nhận tiền.</p></form>}<a asp-action="Index" class="btn fc-outline mt-3">← Danh sách đơn</a>