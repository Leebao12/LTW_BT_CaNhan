@model List<SalesOrder>
@{ViewData["Title"]="Đơn hàng";}
<section class="container section"><p class="eyebrow">FALCON / ĐƠN HÀNG</p><h1 class="h2 mb-4">Đơn hàng</h1><form method="get" class="d-flex gap-2 mb-4"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Tìm mã đơn" aria-label="Tìm đơn hàng"><button class="btn fc-outline">Tìm</button></form><div class="table-responsive"><table class="table"><thead><tr><th>Mã đơn / ngày đặt</th><th>Khách hàng</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var o in Model){<tr><td>@o.OrderCode<div class="small muted">@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div></td><td>@o.CustomerName</td><td>@o.TotalAmount.ToString("N0") ₫</td><td>@StatusText.Of(o.OrderStatus)<div class="small muted">Thanh toán: @StatusText.Of(o.PaymentStatus)</div></td><td><a asp-action="Details" asp-route-id="@o.OrderId" class="btn btn-sm fc-outline">Chi tiết</a></td></tr>}</tbody></table></div>@if(Model.Count==0){<p class="filter-panel">Chưa có đơn hàng phù hợp.</p>}<partial name="_CommercePager"/></section>