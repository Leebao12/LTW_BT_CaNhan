@{ var current=ViewContext.RouteData.Values["controller"]?.ToString(); var menu=new[]{("Home","Tổng quan"),("Products","Sản phẩm"),("Coupons","Mã giảm giá"),("Users","Tài khoản"),("NhaCungCap","Nhà cung cấp"),("Orders","Đơn hàng"),("Bookings","Lịch lái thử")}; }
<!doctype html><html lang="vi" data-bs-theme="dark"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@ViewData["Title"] | FALCON Admin</title><link rel="stylesheet" href="~/assets/bootstrap.min.css"><link rel="stylesheet" href="~/assets/catalog.css"><link rel="stylesheet" href="~/css/integrated.css">@await RenderSectionAsync("Styles",false)</head><body class="admin-shell">
<aside class="admin-sidebar"><a class="brand fs-3" href="/Admin">FALCON</a><p class="eyebrow mt-2 mb-4">QUẢN TRỊ CỬA HÀNG</p><nav aria-label="Điều hướng quản trị">@foreach(var item in menu){<a asp-area="Admin" asp-controller="@item.Item1" asp-action="Index" class="admin-nav @(current==item.Item1 ? "active" : "")">@item.Item2</a>}</nav><a href="/" class="admin-nav mt-4">↗ Xem website</a><p class="muted small mt-4">HỆ THỐNG QUẢN TRỊ</p></aside>
<div class="admin-main"><header class="admin-topbar"><span>@ViewData["Title"]</span><div class="d-flex align-items-center gap-3"><span class="muted">@User.Identity?.Name</span><form asp-area="" asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-sm btn-outline-light">Đăng xuất</button></form></div></header><main class="admin-content">@if(current is not ("Products" or "Users" or "NhaCungCap")){<partial name="_Flash"/>}@RenderBody()</main><footer class="px-4 py-3 small muted">FALCON Motorcycles · @DateTime.Now.Year</footer></div>
<script src="~/assets/bootstrap.bundle.min.js"></script><script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/js/integrated.js"></script><script src="~/js/commerce.js"></script>@await RenderSectionAsync("Scripts",false)</body></html>