@model IEnumerable<Falcon.Web.Models.AppUser>

@{
    ViewData["Title"] = "Quản lý tài khoản";
    var keyword = ViewBag.Keyword as string;
}

<!-- TIÊU ĐỀ VÀ NÚT THÊM -->
<div class="d-flex justify-content-between
            align-items-center flex-wrap gap-3 mb-4">

    <div>
        <p class="eyebrow mb-2">
            USER MANAGEMENT
        </p>

        <h2 class="admin-title mb-1">
            Danh sách tài khoản
        </h2>

        <p class="admin-muted mb-0">
            Quản lý tài khoản khách hàng và trạng thái.
        </p>
    </div>

    <a asp-area="Admin"
       asp-controller="Users"
       asp-action="Create"
       class="btn fc-btn">
        + Thêm tài khoản
    </a>
</div>

<!-- THÔNG BÁO -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<!-- TỔNG QUAN TÀI KHOẢN -->
<div class="row g-3 mb-4">

    <div class="col-md-4">
        <div class="filter-panel h-100">
            <p class="muted mb-2">Tài khoản trong trang này</p>
            <h2 class="text-warning mb-0">
                @Model.Count()
            </h2>
        </div>
    </div>

    <div class="col-md-4">
        <div class="filter-panel h-100">
            <p class="muted mb-2">Đang hoạt động</p>
            <h2 class="text-success mb-0">
                @Model.Count(u => u.Status == "ACTIVE")
            </h2>
        </div>
    </div>

    <div class="col-md-4">
        <div class="filter-panel h-100">
            <p class="muted mb-2">Đã khóa</p>
            <h2 class="text-danger mb-0">
                @Model.Count(u => u.Status == "LOCKED")
            </h2>
        </div>
    </div>

</div>

<!-- KHU VỰC DANH SÁCH -->
<div class="filter-panel">

    <div class="d-flex justify-content-between
                align-items-center flex-wrap gap-3 mb-4">

        <h4 class="mb-0">Danh sách tài khoản</h4>

        <form asp-area="Admin"
              asp-controller="Users"
              asp-action="Index"
              method="get"
              class="d-flex gap-2">

            <input type="text"
                   name="keyword"
                   value="@keyword"
                   class="form-control"
                   placeholder="Tìm username hoặc email..." />

            <button type="submit"
                    class="btn fc-btn">
                Tìm
            </button>

            <a asp-action="Index"
               class="btn fc-outline">
                Xóa lọc
            </a>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table admin-table">

            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Tên đăng nhập</th>
                    <th>Email</th>
                    <th>Vai trò</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>#@user.UserId</td>

                        <td>
                            <strong>@user.Username</strong>
                        </td>

                        <td>@user.Email</td>

                        <td>
                            <span class="badge bg-dark
                                             border border-secondary">
                                @user.Role.RoleName
                            </span>
                        </td>

                        <td>
                            @if (user.Status == "ACTIVE")
                            {
                                <span class="badge bg-success">
                                    Hoạt động
                                </span>
                            }
                            else if (user.Status == "LOCKED")
                            {
                                <span class="badge bg-danger">
                                    Đã khóa
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Ngừng hoạt động
                                </span>
                            }
                        </td>

                        <td>
                            <div class="admin-actions">

                                <a asp-action="Details"
                                   asp-route-id="@user.UserId"
                                   class="btn btn-sm btn-admin-outline">
                                    Chi tiết
                                </a>

@if(user.Role.RoleName!="Admin"){
                                <a asp-action="Edit"
                                   asp-route-id="@user.UserId"
                                   class="btn btn-sm btn-warning">
                                    Sửa
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@user.UserId"
                                   class="btn btn-sm btn-outline-danger">
                                    Xóa / Khóa
                                </a>

}else{<span class="small muted">Admin được bảo vệ</span>}
                            </div>
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6"
                            class="text-center py-5">

                            <p class="muted mb-2">
                                Chưa tìm thấy tài khoản nào.
                            </p>

                            <a asp-action="Create"
                               class="btn fc-btn">
                                Thêm tài khoản đầu tiên
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<p class="muted mt-3">Tổng @ViewBag.Total kết quả · Trang @ViewBag.Page / @ViewBag.Pages</p><nav aria-label="Phân trang tài khoản"><ul class="pagination flex-wrap">@for(int i=Math.Max(1,(int)ViewBag.Page-2);i<=Math.Min((int)ViewBag.Pages,(int)ViewBag.Page+2);i++){<li class="page-item @(i==(int)ViewBag.Page?"active":"")"><a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-keyword="@keyword">@i</a></li>}</ul></nav>