@model Falcon.Web.Models.UserCreateVm

@{
    ViewData["Title"] = "Thêm tài khoản";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="filter-panel">

            <p class="eyebrow">
                FALCON / USER MANAGEMENT
            </p>

            <h2 class="admin-title mb-2">
                Tạo tài khoản mới
            </h2>

            <p class="admin-muted mb-4">
                Nhập thông tin để đăng ký tài khoản trong hệ thống.
            </p>

            <form asp-area="Admin"
                  asp-controller="Users"
                  asp-action="Create"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="admin-error mb-3"></div>

                <div class="row g-4">

                    <div class="col-md-6">
                        <label asp-for="Username"
                               class="admin-label">
                            Tên đăng nhập
                        </label>

                        <input asp-for="Username"
                               class="form-control"
                               placeholder="Nhập username"
                               autocomplete="off" />

                        <span asp-validation-for="Username"
                              class="admin-error"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email"
                               class="admin-label">
                            Email
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="example@gmail.com" />

                        <span asp-validation-for="Email"
                              class="admin-error"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Password"
                               class="admin-label">
                            Mật khẩu
                        </label>

                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               autocomplete="new-password"
                               placeholder="Tối thiểu 8 ký tự" />

                        <span asp-validation-for="Password"
                              class="admin-error"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword"
                               class="admin-label">
                            Xác nhận mật khẩu
                        </label>

                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="form-control"
                               autocomplete="new-password"
                               placeholder="Nhập lại mật khẩu" />

                        <span asp-validation-for="ConfirmPassword"
                              class="admin-error"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="RoleId"
                               class="admin-label">
                            Vai trò
                        </label>

                        <select asp-for="RoleId"
                                asp-items="ViewBag.RoleOptions"
                                class="form-select">

                            <option value="0">
                                -- Chọn vai trò --
                            </option>
                        </select>

                        <span asp-validation-for="RoleId"
                              class="admin-error"></span>
                    </div>

                </div>

                <div class="alert alert-warning mt-4">
                    Mật khẩu sẽ được băm trước khi lưu vào
                    cơ sở dữ liệu. Không hiển thị lại mật khẩu
                    sau khi tạo tài khoản.
                </div>

                <div class="d-flex gap-3 mt-4">

                    <button type="submit"
                            class="btn fc-btn">
                        Lưu tài khoản
                    </button>

                    <a asp-area="Admin"
                       asp-controller="Users"
                       asp-action="Index"
                       class="btn fc-outline">
                        Hủy
                    </a>

                </div>
            </form>

        </div>
    </div>
</div>