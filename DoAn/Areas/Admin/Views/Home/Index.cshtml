@model Falcon.Web.Services.DashboardData
@{ViewData["Title"]="Tổng quan cửa hàng";var maximum=Math.Max(1,Model.DoanhThuTheoThang.Max(m=>m.DoanhThu));}
<div class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><p class="eyebrow">FALCON / ADMIN DASHBOARD</p><h1 class="h2">Tổng quan cửa hàng</h1><p class="muted">Số liệu từ cơ sở dữ liệu tại thời điểm tải trang.</p></div><a asp-controller="Products" asp-action="Create" class="btn btn-gold align-self-center">+ Thêm xe mới</a></div>
<div class="row g-3 mb-4">@foreach(var item in new[]{("Tổng mẫu xe",Model.TongSoMauXe),("Tổng xe tồn kho",Model.TongSoLuongXe),("Mẫu xe hết hàng",Model.HetHang),("Mẫu xe nổi bật",Model.NoiBat),("Tài khoản",Model.TaiKhoan),("NCC hoạt động",Model.NhaCungCapHoatDong),("Xe đã bán · đơn hoàn tất",Model.SoXeDaBan)}){<div class="col-sm-6 col-xl-3"><div class="filter-panel h-100"><p class="muted">@item.Item1</p><p class="stat-number mb-0">@item.Item2.ToString("N0")</p></div></div>}</div>
<section class="filter-panel"><h2 class="h4">Doanh thu theo tháng · @DateTime.Today.Year</h2><p class="muted">Đơn hoàn tất theo UpdatedAt · Tổng TotalAmount · Không cộng riêng tiền cọc.</p>@if(Model.DoanhThuTheoThang.All(m=>m.DoanhThu==0)){<p class="text-warning">Chưa có doanh thu từ đơn hoàn tất trong năm.</p>}
@foreach(var m in Model.DoanhThuTheoThang){<div class="row align-items-center gy-1 mb-3"><div class="col-2 col-md-1">T@m.Thang</div><div class="col-6 col-md-8"><div class="bar" style="width:@((m.DoanhThu/maximum*100).ToString("0.##",System.Globalization.CultureInfo.InvariantCulture))%" role="img" aria-label="Tháng @m.Thang: @m.DoanhThu.ToString("N0") đồng"></div></div><div class="col-4 col-md-3 text-end small">@m.DoanhThu.ToString("N0") ₫</div></div>}
</section>