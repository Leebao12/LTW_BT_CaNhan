@model List<Falcon.Web.Models.NhaCungCap>

@{
    ViewData["Title"] = "Quản lý nhà cung cấp";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .supplier-page {
        color: #f5f5f7;
    }

    .supplier-card {
        background: #1e1e24;
        border: 1px solid #38383f;
        border-radius: 12px;
    }

    .supplier-title {
        color: #e5c158;
        font-weight: 700;
    }

    .supplier-table {
        color: #f5f5f7;
        vertical-align: middle;
    }

    .supplier-table thead th {
        background: #2c2c34;
        color: #e5c158;
        white-space: nowrap;
    }

    .supplier-table td {
        background: #1e1e24;
        border-color: #38383f;
    }

    .supplier-table tbody tr:hover td {
        background: #292930;
    }

    .search-input {
        background: #121212;
        color: white;
        border: 1px solid #555;
    }

    .search-input:focus {
        background: #121212;
        color: white;
        border-color: #d4af37;
        box-shadow: 0 0 0 0.2rem rgba(212,175,55,.15);
    }

    .btn-gold {
        background: #d4af37;
        color: #121212;
        font-weight: 600;
        border: none;
    }

    .btn-gold:hover {
        background: #e5c158;
        color: #121212;
    }
    
    .table tbody tr td {
        color: #ffffff !important;
    }
</style>

<div class="supplier-page">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h3 class="supplier-title mb-1">
                <i class="bi bi-buildings"></i>
                Quản lý nhà cung cấp
            </h3>
            <p class="text-secondary mb-0">
                Quản lý thông tin và trạng thái nhà cung cấp
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="NhaCungCap"
           asp-action="Create"
           class="btn btn-gold">
            <i class="bi bi-plus-circle"></i>
            Thêm nhà cung cấp
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="supplier-card p-3 mb-4">
        <form asp-area="Admin"
              asp-controller="NhaCungCap"
              asp-action="Index"
              method="get"
              class="row g-2">

            <div class="col-md-9">
                <input type="text"
                       name="keyword"
                       value="@ViewBag.Keyword"
                       class="form-control search-input"
                       placeholder="Nhập tên nhà cung cấp cần tìm..." />
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-gold flex-fill">
                    <i class="bi bi-search"></i>
                    Tìm kiếm
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-light">
                    Xóa lọc
                </a>
            </div>
        </form>
    </div>

    <div class="supplier-card p-3">
        <div class="d-flex justify-content-between mb-3">
            <h5 class="supplier-title mb-0">Danh sách nhà cung cấp</h5>
            <span class="text-secondary">
                Tổng: @Model.Count nhà cung cấp
            </span>
        </div>

        <div class="table-responsive">
            <table class="table supplier-table table-bordered mb-0 ">
                <thead>
                    <tr>
                        <th>Mã NCC</th>
                        <th>Tên nhà cung cấp</th>
                        <th>Điện thoại</th>
                        <th>Email</th>
                        <th>Loại nhà cung cấp</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>

                <tbody style="color: white;">
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center text-secondary py-4">
                                Không tìm thấy nhà cung cấp.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.MaNhaCungCap</td>
                                <td class="fw-semibold">@item.TenNhaCungCap</td>
                                <td>@item.SoDienThoai</td>
                                <td>@(item.Email ?? "—")</td>
                                <td>@item.LoaiNhaCungCap</td>

                                <td>
                                    @if (item.DangHoatDong)
                                    {
                                        <span class="badge bg-success">
                                            Đang hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Ngừng hoạt động
                                        </span>
                                    }
                                </td>

                                <td class="text-center text-nowrap">
                                    <a asp-action="Details"
                                       asp-route-id="@item.MaNhaCungCap"
                                       class="btn btn-sm btn-outline-info"
                                       title="Chi tiết">
                                        Chi tiết
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.MaNhaCungCap"
                                       class="btn btn-sm btn-outline-warning"
                                       title="Sửa">
                                        Sửa
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@item.MaNhaCungCap"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc chắn muốn xử lý nhà cung cấp này? Nếu đã có đơn nhập kho, nhà cung cấp sẽ được chuyển sang ngừng hoạt động.');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                title="Xóa hoặc ngừng hoạt động">
                                            Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>