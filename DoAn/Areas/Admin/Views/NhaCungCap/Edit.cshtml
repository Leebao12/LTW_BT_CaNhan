@model Falcon.Web.Models.NhaCungCap

@{
    ViewData["Title"] = "Cập nhật nhà cung cấp";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .supplier-form-card {
        background: #1e1e24;
        border: 1px solid #38383f;
        border-radius: 12px;
        color: #f5f5f7;
    }

    .supplier-form-card h3 {
        color: #e5c158;
    }

    .supplier-form-card .form-control {
        background: #121212;
        color: white;
        border: 1px solid #555;
    }

    .supplier-form-card .form-control:focus {
        border-color: #d4af37;
        box-shadow: 0 0 0 .2rem rgba(212,175,55,.15);
    }

    .supplier-form-card .form-label {
        color: #e5c158;
    }

    .btn-gold {
        background: #d4af37;
        color: #121212;
        font-weight: 600;
    }
</style>

<div class="supplier-form-card p-4">

    <h3 class="mb-2">
        Sửa
        Cập nhật nhà cung cấp
    </h3>

    <p class="text-secondary mb-4">
        Mã nhà cung cấp: @Model.MaNhaCungCap
    </p>

    <form asp-action="Edit"
          asp-route-id="@Model.MaNhaCungCap"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="MaNhaCungCap" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"></div>

        <div class="row g-3">

            <div class="col-md-6">
                <label asp-for="TenNhaCungCap" class="form-label"></label>
                <input asp-for="TenNhaCungCap" class="form-control" />
                <span asp-validation-for="TenNhaCungCap"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="SoDienThoai" class="form-label"></label>
                <input asp-for="SoDienThoai" class="form-control" />
                <span asp-validation-for="SoDienThoai"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="LoaiNhaCungCap" class="form-label"></label>
                <select asp-for="LoaiNhaCungCap" class="form-select"><option value="Xe">Xe</option><option value="Phu tung">Phụ tùng</option><option value="Ca hai">Cả hai</option></select>
                <span asp-validation-for="LoaiNhaCungCap"
                      class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="DiaChi" class="form-label"></label>
                <textarea asp-for="DiaChi"
                          class="form-control"
                          rows="3"></textarea>
                <span asp-validation-for="DiaChi"
                      class="text-danger"></span>
            </div>

            <div class="col-12">
                <div class="form-check">
                    <input asp-for="DangHoatDong"
                           class="form-check-input"
                           type="checkbox" />

                    <label asp-for="DangHoatDong"
                           class="form-check-label">
                        Đang hoạt động
                    </label>
                </div>
            </div>

        </div>

        <hr class="border-secondary my-4" />

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-gold">
                <i class="bi bi-save"></i>
                Lưu thay đổi
            </button>

            <a asp-action="Index" class="btn btn-outline-light">
                <i class="bi bi-arrow-left"></i>
                Quay lại
            </a>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}